generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum PromoLinkType {
  TELEGRAM_BOT
  TELEGRAM_MINI_APP
  PUBLIC_SITE
}

model User {
  id         String  @id @default(cuid())
  telegramId String? @unique

  email        String @unique
  nickname     String @unique
  role         String @default("user")
  passwordHash String

  phone      String?
  avatarUrl  String?
  avatarHash String?

  promoLinkId String?
  sourceCode  String?
  sourceType  PromoLinkType?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  promoLink             PromoLink?             @relation(fields: [promoLinkId], references: [id], onDelete: SetNull)
  registrations         EventRegistration[]
  ratings               Rating[]
  feedback              Feedback[]
  warmups               UserWarmup[]
  passwordResetTokens   PasswordResetToken[]
  clientUiRegistrations ClientUiRegistration[]
  notifications         NotificationQueue[]

  @@index([role])
  @@index([promoLinkId])
  @@index([sourceCode])
  @@index([sourceType])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PromoLink {
  id                 String              @id @default(cuid())
  name               String
  code               String              @unique
  type               PromoLinkType       @default(PUBLIC_SITE)
  targetUrl          String?
  generatedUrl       String?
  clicksCount        Int                 @default(0)
  registrationsCount Int                 @default(0)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  startSessions      PromoStartSession[]
  clicks             PromoClick[]

  @@index([type])
  @@index([isActive])
  @@index([createdAt])
}

model PromoStartSession {
  id             String        @id @default(cuid())
  telegramUserId String        @unique
  promoCode      String
  promoLinkId    String?
  type           PromoLinkType @default(PUBLIC_SITE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  promoLink      PromoLink?    @relation(fields: [promoLinkId], references: [id], onDelete: SetNull)

  @@index([promoCode])
  @@index([promoLinkId])
  @@index([type])
}

model PromoClick {
  id             String        @id @default(cuid())
  promoLinkId    String
  code           String
  type           PromoLinkType
  telegramUserId String?
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  promoLink      PromoLink     @relation(fields: [promoLinkId], references: [id], onDelete: Cascade)

  @@index([promoLinkId])
  @@index([code])
  @@index([type])
  @@index([telegramUserId])
  @@index([createdAt])
}

model Event {
  id                   String              @id @default(cuid())
  imageUrl             String?
  imageHash            String?
  title                String
  city                 String
  address              String
  features             String
  gameRules            String
  gameType             String
  startsAt             DateTime
  endsAt               DateTime?
  reminderSentNow      Boolean             @default(false)
  reminderSent24h      Boolean             @default(false)
  reminderSent2h       Boolean             @default(false)
  reminderSent15m      Boolean             @default(false)
  participantLimit     Int
  seatsPerTable        Int                 @default(9)
  initialDepositAmount Int                 @default(0)
  isTemplate           Boolean?            @default(false)
  status               String              @default("published")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  registrations        EventRegistration[]

  @@index([gameType, startsAt])
  @@index([status])
}

model EventRegistration {
  id          String    @id @default(cuid())
  userId      String
  eventId     String
  status      String    @default("PARTICIPANT")
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?
  points      Int       @default(0)
  bounty      Int       @default(0)
  position    Int?
  tableNumber Int?
  seatNumber  Int?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@unique([eventId, tableNumber, seatNumber])
  @@index([eventId, status])
  @@index([userId, status])
}

model Rating {
  id               String   @id @default(cuid())
  userId           String
  gameType         String
  points           Int      @default(0)
  bountyAdjustment Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameType])
  @@index([gameType, points])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

model ContentPage {
  id        String   @id @default(cuid())
  key       String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientUiSetting {
  id        String   @id @default("default")
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientUiRegistration {
  id        String   @id @default(cuid())
  userId    String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([type, createdAt])
  @@index([userId])
}

enum WarmupStatus {
  active
  completed
  stopped
}

model UserWarmup {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioKey String
  currentStep Int          @default(0)
  status      WarmupStatus @default(active)
  startedAt   DateTime     @default(now())
  nextSendAt  DateTime?
  completedAt DateTime?
  stoppedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, scenarioKey])
  @@index([status, nextSendAt])
}

enum NotificationStatus {
  pending
  processing
  sent
  failed
  cancelled
}

enum NotificationType {
  warmup
  broadcast
  event_reminder
}

model Broadcast {
  id            String              @id @default(cuid())
  message       String
  imageUrl      String?
  buttonText    String?
  buttonUrl     String?
  totalUsers    Int
  createdCount  Int
  skippedCount  Int
  createdAt     DateTime            @default(now())
  notifications NotificationQueue[]

  @@index([createdAt])
}

model NotificationQueue {
  id             String             @id @default(cuid())
  userId         String?
  broadcastId    String?
  telegramUserId Int
  type           NotificationType
  status         NotificationStatus @default(pending)
  message        String
  attempts       Int                @default(0)
  scheduledAt    DateTime           @default(now())
  sentAt         DateTime?
  failedAt       DateTime?
  error          String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([telegramUserId, status])
  @@index([broadcastId, status])
}
